{
  "name": "nestscout-repository-tooling",
  "version": "0.0.0",
  "private": true,
  "description": "Engineering tooling and the NestScout mobile application foundation.",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/mobile"
  ],
  "scripts": {
    "identity": "node scripts/verify-repository.mjs",
    "tools:install": "node scripts/install-tools.mjs",
    "tools:list": "node scripts/tool-library.mjs",
    "tools:doctor": "node scripts/tool-doctor.mjs",
    "tools:smoke": "node scripts/tool-smoke.mjs",
    "check:capabilities": "node scripts/tool-library.mjs --validate",
    "lint:markdown": "markdownlint-cli2",
    "lint:yaml": "node scripts/check-yaml.mjs",
    "lint:workflows": "node scripts/check-tools.mjs workflows",
    "check:reserved": "node scripts/check-reserved-files.mjs",
    "check:hygiene": "node scripts/check-hygiene.mjs",
    "check:comments": "node scripts/check-comments.mjs",
    "check:format": "node scripts/check-format.mjs",
    "check:languages": "node scripts/check-languages.mjs",
    "check:metadata": "node scripts/check-metadata.mjs",
    "scan:secrets": "node scripts/check-tools.mjs secrets",
    "check": "npm run check:reserved && npm run check:hygiene && npm run check:comments && npm run check:format && npm run check:languages && npm run check:metadata && npm run lint:markdown && npm run lint:yaml && npm run lint:workflows && npm run scan:secrets && npm run verify:supabase && npm run typecheck:db && npm run typecheck:kael && npm run check:test-selection && npm run check:capabilities && npm run verify:foundation && npm run check:skills && npm run check:mobile",
    "check:skills": "node scripts/check-skills.mjs",
    "check:mobile": "npm run typecheck:mobile && npm run lint:mobile && npm run test:mobile",
    "typecheck:mobile": "npm run typecheck --workspace apps/mobile",
    "lint:mobile": "npm run lint --workspace apps/mobile",
    "test:mobile": "npm run test --workspace apps/mobile",
    "verify:mobile-sdk": "npm run verify:sdk --workspace apps/mobile",
    "check:test-selection": "node scripts/check-test-selection.mjs",
    "verify:negative": "node scripts/verify-negative.mjs && node scripts/run-tests.mjs scripts/check-hygiene.test.mjs scripts/check-verification.test.mjs scripts/test-lifecycle.test.mjs scripts/check-comments.test.mjs scripts/check-format.test.mjs scripts/check-languages.test.mjs scripts/tool-library.test.mjs",
    "db:start": "node scripts/supabase-local.mjs start",
    "db:status": "node scripts/supabase-local.mjs status",
    "db:reset": "node scripts/supabase-local.mjs reset",
    "db:test": "node scripts/supabase-local.mjs test",
    "db:mcp:test": "node scripts/run-tests.mjs scripts/supabase-mcp.integration.test.mjs",
    "db:types": "node scripts/supabase-local.mjs types",
    "db:types:check": "node scripts/supabase-local.mjs check-types",
    "db:lint": "node scripts/supabase-local.mjs lint",
    "db:drift": "node scripts/supabase-local.mjs drift",
    "db:history": "node scripts/supabase-local.mjs history",
    "db:stop": "node scripts/supabase-local.mjs stop",
    "kael:serve": "node scripts/supabase-local.mjs serve-kael",
    "kael:knowledge:validate": "node scripts/kael-knowledge.mjs validate",
    "kael:knowledge:seed": "node scripts/kael-knowledge.mjs seed",
    "kael:knowledge:benchmark": "node scripts/kael-knowledge.mjs benchmark",
    "kael:intelligence:evaluate": "node scripts/kael-intelligence-evaluation.mjs",
    "kael:live:review": "node scripts/kael-live-evaluation.mjs --review",
    "kael:live:dry-run": "node scripts/kael-live-evaluation.mjs --dry-run",
    "kael:live:preflight": "node scripts/kael-live-evaluation.mjs --preflight",
    "verify:supabase": "node scripts/run-tests.mjs scripts/supabase-local.test.mjs",
    "typecheck:db": "tsc --noEmit --strict --skipLibCheck supabase/database.types.ts",
    "typecheck:kael": "tsc --noEmit --strict --skipLibCheck --noUncheckedIndexedAccess --target es2024 --module esnext --moduleResolution bundler --allowImportingTsExtensions --verbatimModuleSyntax --erasableSyntaxOnly --lib es2024,dom,dom.iterable,dom.asynciterable supabase/functions/kael/index.ts services/kael-core/src/knowledge-sources.ts",
    "verify:foundation": "node scripts/run-tests.mjs scripts/backup.test.mjs scripts/agent-evaluation.test.mjs scripts/git-environment.test.mjs scripts/tool-workflows.test.mjs scripts/advisory-workflows.test.mjs scripts/check-skills.test.mjs scripts/test-integrity-reporter.test.mjs scripts/send-sms-hook.test.mjs scripts/kael-core.test.mjs scripts/kael-evaluation.test.mjs scripts/kael-knowledge.test.mjs scripts/kael-live-evaluation.test.mjs scripts/review-diff.test.mjs scripts/dead-code-evaluation.test.mjs",
    "agents:evaluate": "node scripts/agent-evaluation.mjs",
    "health:dead-code": "knip --no-exit-code --no-progress",
    "health:review-diff": "node scripts/review-diff.mjs",
    "tools:help": "node scripts/tool-help.mjs",
    "tools:trivy:smoke": "node scripts/tool-workflows.mjs trivy",
    "tools:k6:smoke": "node scripts/tool-workflows.mjs k6",
    "tools:postgresql": "node scripts/postgresql-clients.mjs",
    "tools:trivy:db": "node scripts/advisory-workflows.mjs trivy",
    "tools:osv:source": "node scripts/advisory-workflows.mjs osv online",
    "tools:linux:smoke": "node scripts/tool-workflows.mjs linux"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "acorn": "8.19.0",
    "knip": "6.42.1",
    "markdownlint-cli2": "0.24.0",
    "smol-toml": "1.9.1",
    "supabase": "2.122.0",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  },
  "overrides": {
    "katex": "0.18.2",
    "react": "19.3.0"
  },
  "knip": {
    "workspaces": {
      ".": {
        "entry": [
          "scripts/*.test.mjs",
          "scripts/supabase-mcp.mjs",
          "scripts/test-integrity-reporter.mjs",
          "supabase/database.types.ts",
          "supabase/functions/kael/index.ts"
        ],
        "project": [
          "scripts/**/*.mjs",
          "supabase/**/*.ts",
          "services/**/*.ts"
        ],
        "ignoreDependencies": [
          "supabase"
        ]
      },
      "apps/mobile": {
        "ignoreDependencies": [
          "expo-updates"
        ]
      }
    }
  }
}
