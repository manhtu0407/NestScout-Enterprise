{
  "name": "nestscout-repository-tooling",
  "version": "0.0.0",
  "private": true,
  "description": "Engineering tooling only; no product application is implemented.",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "identity": "node scripts/verify-repository.mjs",
    "tools:install": "node scripts/install-tools.mjs",
    "lint:markdown": "markdownlint-cli2",
    "lint:yaml": "node scripts/check-yaml.mjs",
    "lint:workflows": "node scripts/check-tools.mjs workflows",
    "check:reserved": "node scripts/check-reserved-files.mjs",
    "check:hygiene": "node scripts/check-hygiene.mjs",
    "check:metadata": "node scripts/check-metadata.mjs",
    "scan:secrets": "node scripts/check-tools.mjs secrets",
    "check": "npm run check:reserved && npm run check:hygiene && npm run check:metadata && npm run lint:markdown && npm run lint:yaml && npm run lint:workflows && npm run scan:secrets && npm run verify:supabase && npm run typecheck:db && npm run verify:foundation",
    "verify:negative": "node scripts/verify-negative.mjs && node --test scripts/check-hygiene.test.mjs scripts/check-verification.test.mjs",
    "db:start": "node scripts/supabase-local.mjs start",
    "db:status": "node scripts/supabase-local.mjs status",
    "db:reset": "node scripts/supabase-local.mjs reset",
    "db:test": "node scripts/supabase-local.mjs test",
    "db:mcp:test": "node --test scripts/supabase-mcp.integration.test.mjs",
    "db:types": "node scripts/supabase-local.mjs types",
    "db:types:check": "node scripts/supabase-local.mjs check-types",
    "db:lint": "node scripts/supabase-local.mjs lint",
    "db:drift": "node scripts/supabase-local.mjs drift",
    "db:history": "node scripts/supabase-local.mjs history",
    "db:stop": "node scripts/supabase-local.mjs stop",
    "verify:supabase": "node --test scripts/supabase-local.test.mjs",
    "typecheck:db": "tsc --noEmit --strict --skipLibCheck supabase/database.types.ts",
    "verify:foundation": "node --test scripts/backup.test.mjs scripts/agent-evaluation.test.mjs scripts/git-environment.test.mjs",
    "agents:evaluate": "node scripts/agent-evaluation.mjs"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "acorn": "8.19.0",
    "markdownlint-cli2": "0.24.0",
    "smol-toml": "1.9.1",
    "supabase": "2.122.0",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  },
  "overrides": {
    "katex": "0.18.2"
  }
}
