{
  "version": 2,
  "conditionalLanguages": [],
  "languages": {
    "typescript": [".ts", ".tsx", ".mts", ".cts"],
    "javascript": [".js", ".jsx", ".mjs", ".cjs"],
    "sql": [".sql"],
    "shell": [".sh", ".bash", ".zsh"],
    "powershell": [".ps1", ".psm1"],
    "python": [".py", ".pyi", ".pyw", ".ipynb"],
    "rust": [".rs"],
    "go": [".go"],
    "java": [".java"],
    "kotlin": [".kt", ".kts"],
    "swift": [".swift"],
    "objectivec": [".m", ".mm"],
    "c": [".c", ".h"],
    "cpp": [".cc", ".cpp", ".cxx", ".hpp"],
    "csharp": [".cs", ".csproj", ".sln"],
    "ruby": [".rb"],
    "php": [".php"],
    "dart": [".dart"],
    "lua": [".lua"],
    "perl": [".pl", ".pm"]
  },
  "interpreters": {
    "node": "javascript",
    "deno": "javascript",
    "bun": "javascript",
    "sh": "shell",
    "dash": "shell",
    "bash": "shell",
    "zsh": "shell",
    "pwsh": "powershell",
    "powershell": "powershell",
    "python": "python",
    "ruby": "ruby",
    "perl": "perl",
    "php": "php",
    "lua": "lua"
  },
  "manifests": {
    "requirements.txt": "python",
    "pyproject.toml": "python",
    "Pipfile": "python",
    "poetry.lock": "python",
    "uv.lock": "python",
    ".python-version": "python",
    "Cargo.toml": "rust",
    "Cargo.lock": "rust",
    "rust-toolchain": "rust",
    "rust-toolchain.toml": "rust",
    "go.mod": "go",
    "go.sum": "go",
    "pom.xml": "java",
    "build.gradle": "java",
    "build.gradle.kts": "java",
    "settings.gradle": "java",
    "Gemfile": "ruby",
    ".ruby-version": "ruby",
    "composer.json": "php",
    "Package.swift": "swift",
    "Podfile": "swift",
    "pubspec.yaml": "dart"
  },
  "setupActions": {
    "actions/setup-python": "python",
    "astral-sh/setup-uv": "python",
    "dtolnay/rust-toolchain": "rust",
    "actions-rust-lang/": "rust",
    "actions-rs/": "rust",
    "actions/setup-go": "go",
    "actions/setup-java": "java",
    "actions/setup-dotnet": "csharp",
    "ruby/setup-ruby": "ruby",
    "shivammathur/setup-php": "php",
    "subosito/flutter-action": "dart",
    "swift-actions/setup-swift": "swift"
  },
  "modules": [
    {
      "path": "apps/mobile/",
      "domain": "NestScout mobile application and Kael UI/UX",
      "languages": ["typescript"]
    },
    {
      "path": "services/",
      "domain": "NestScout application services other than the Kael runtime",
      "languages": ["typescript"]
    },
    {
      "path": "services/kael-core/",
      "domain": "Kael Backend, AI Core, Agent Runtime, Memory, Reasoning and Tools",
      "languages": ["rust", "python", "go"]
    },
    {
      "path": "supabase/functions/kael/",
      "domain": "Kael Backend, AI Core, Agent Runtime, Memory, Reasoning and Tools",
      "languages": ["rust", "python", "go"]
    },
    {
      "path": "supabase/",
      "domain": "Supabase integrations, database migrations and row-level security",
      "languages": ["sql", "typescript"]
    },
    {
      "path": "scripts/",
      "domain": "Repository tooling",
      "languages": ["javascript"]
    },
    {
      "path": ".githooks/",
      "domain": "Optional local Git hooks",
      "languages": ["shell"]
    }
  ],
  "kaelBackend": {
    "paths": ["services/kael-core/", "supabase/functions/kael/"],
    "priority": ["rust", "python", "go"],
    "legacyTypeScript": [
      "services/kael-core/src/anthropic.ts",
      "services/kael-core/src/config.ts",
      "services/kael-core/src/context.ts",
      "services/kael-core/src/deepseek.ts",
      "services/kael-core/src/developer-pilot.ts",
      "services/kael-core/src/events.ts",
      "services/kael-core/src/executor.ts",
      "services/kael-core/src/gateway.ts",
      "services/kael-core/src/intelligence.ts",
      "services/kael-core/src/knowledge-cases.ts",
      "services/kael-core/src/knowledge-contract.ts",
      "services/kael-core/src/knowledge-sources.ts",
      "services/kael-core/src/model.ts",
      "services/kael-core/src/perplexity.ts",
      "services/kael-core/src/policy.ts",
      "services/kael-core/src/runtime.ts",
      "services/kael-core/src/sse.ts",
      "services/kael-core/src/store.ts",
      "services/kael-core/src/tasks.ts",
      "services/kael-core/src/tools.ts",
      "supabase/functions/kael/index.ts"
    ]
  },
  "exceptions": [
    {
      "path": "apps/mobile/eslint.config.mjs",
      "language": "javascript",
      "justification": "ESLint flat configuration is loaded by the Node ESLint runtime and is part of the approved Application Foundation V2 mobile tooling.",
      "approval": "Pre-existing owner-approved mobile workspace tooling, preserved unchanged"
    }
  ]
}
