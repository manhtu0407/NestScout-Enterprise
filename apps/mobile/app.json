{
  "expo": {
    "name": "NestScout",
    "slug": "nestscout",
    "version": "0.0.0",
    "scheme": "nestscout",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": ["ios", "web"],
