{
  "expo": {
    "name": "NestScout",
    "slug": "nestscout",
    "version": "0.1.0",
    "scheme": "nestscout",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "platforms": ["ios", "web"],
    "ios": {
      "bundleIdentifier": "com.phanmanhtu.nestscout.horizon",
      "icon": "./assets/horizon/app-icon.png",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "NestScout cần truy cập mạng nội bộ để kết nối máy chủ phát triển.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": ["expo-router", ["expo-image-picker", { "photosPermission": "NestScout cần quyền truy cập ảnh để bạn chọn ảnh đính kèm.", "cameraPermission": false, "microphonePermission": false }]],
    "extra": {
      "eas": {
        "projectId": "d984de7d-3c69-41a5-841f-a604d10d4f11"
      }
    },
    "owner": "nestscout"
  }
}
