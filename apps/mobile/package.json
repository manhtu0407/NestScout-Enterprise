{
  "name": "@nestscout/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "NestScout Expo application: guest entry, phone OTP sign-in and Client/Worker mode gates.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "jest --ci",
    "verify:sdk": "expo install --check"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "0.4.2",
    "@expo/metro-runtime": "58.0.17",
    "@supabase/supabase-js": "2.119.0",
    "expo": "~58.0.25",
    "expo-apple-authentication": "~58.0.3",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "58.0.5",
    "expo-haptics": "~58.0.8",
    "expo-image-picker": "58.0.10",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-speech-recognition": "58.0.1",
    "expo-status-bar": "~58.0.5",
    "expo-video": "~58.0.14",
    "expo-web-browser": "~58.0.8",
    "libphonenumber-js": "1.13.15",
    "lucide-react-native": "1.66.0",
    "markdown-it": "15.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "4.0.0",
    "react-native-web": "0.21.4"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-expo": "58.0.4",
    "jest": "30.5.2",
    "jest-expo": "58.0.14",
    "typescript": "6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "passWithNoTests": false,
    "maxWorkers": 4,
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^lucide-react-native$": "<rootDir>/../../node_modules/lucide-react-native/dist/cjs/lucide-react-native.js",
      "^expo-speech-recognition$": "<rootDir>/src/testing/expo-speech-recognition.ts"
    },
    "testMatch": [
      "**/src/**/*.test.ts",
      "**/src/**/*.test.tsx"
    ]
  }
}
