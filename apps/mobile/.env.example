# Public configuration bundled into the app. Everything here is readable by anyone
# who installs the app: never put a secret key, service_role key, SMS, AI or
# signing credential in this file.
# Only the isolated local Supabase stack is supported. Take the URL and the
# publishable key from `npm run db:status` / the local stack; its port is dynamic.
EXPO_PUBLIC_NESTSCOUT_TARGET=local
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_with_local_key
